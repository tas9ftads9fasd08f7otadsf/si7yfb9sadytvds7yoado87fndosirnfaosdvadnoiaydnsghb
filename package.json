{
  "name": "mapeditor-fe",
  "version": "0.1.0",
  "private": true,
  "rikiCore": { "ref": "e734154937931786323c3e42f372d551fd8cdff9", "sha256": "e004d36a62327cc420b61a2463f4d4ecdd6fe7bd9ef77232ee95c0d8ce95c531" },
  "description": "The map editor a sharing phone serves to browsers, built by Next.js and shipped inside the app",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "phone": "node e2e/mock-phone.mjs",
    "build": "next build",
    "pack": "node scripts/pack.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:php && npm run build && npm run test:e2e && npm run pack && npm run build:web && RIKI_PACK_WITHOUT_CORE=1 npm run pack:web && npm run test:e2e:web",
    "build:web": "RIKI_TARGET=web next build",
    "build:core": "node scripts/build-core.mjs",
    "fetch:core": "node scripts/fetch-core.mjs",
    "build:words": "node scripts/build-words.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "pack:web": "node scripts/pack-web.mjs",
    "test:php": "cd server && vendor/bin/phpunit",
    "test:e2e:web": "RIKI_TARGET=web playwright test",
    "phone:real": "REAL_MAP=1 node e2e/mock-phone.mjs",
    "real-region": "node scripts/real-region.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@maplibre/maplibre-gl-style-spec": "20.4.0",
    "fflate": "0.8.2",
    "lucide-static": "1.70.0",
    "maplibre-gl": "4.7.1",
    "next": "16.4.5",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "20.4.0",
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "binaryen": "123.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
