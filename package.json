{
  "name": "mapeditor-fe",
  "version": "0.1.0",
  "private": true,
  "description": "The map editor a sharing phone serves to browsers, built by Next.js and shipped inside the app",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "phone": "node e2e/mock-phone.mjs",
    "build": "next build",
    "pack": "node scripts/pack.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:php && npm run build && npm run test:e2e && npm run pack && npm run build:web && npm run pack:web && npm run test:e2e:web",
    "build:web": "RIKI_TARGET=web next build",
    "pack:web": "node scripts/pack-web.mjs",
    "test:php": "cd server && vendor/bin/phpunit",
    "test:e2e:web": "RIKI_TARGET=web playwright test"
  },
  "dependencies": {
    "maplibre-gl": "4.7.1",
    "next": "16.4.5",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "20.4.0",
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
